# Momzz Enterprise MCP Server Environment Configuration

PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/momzz

# Upstream Backend API Configuration
UPSTREAM_API_URL=http://localhost:5000
INTERNAL_SERVICE_KEY=momzz_internal_service_key_enterprise_mcp_secure

# Optional JWT access secret fallback (for verifying existing user JWTs)
JWT_ACCESS_SECRET=momzz_dev_access_secret_only

# Network & Transport Security
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=localhost:4000,127.0.0.1:4000,localhost,127.0.0.1

# TLS 1.2+ HTTPS Configuration (Set USE_HTTPS=true in production)
USE_HTTPS=false
SSL_KEY_PATH=
SSL_CERT_PATH=
